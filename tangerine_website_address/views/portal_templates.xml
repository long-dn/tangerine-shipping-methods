<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_my_details_fields" name="portal_my_details_fields" inherit_id="portal.portal_my_details_fields">
        <xpath expr="//select[@name='state_id']/.." position="after">
            <div id="div_ward"
                 t-attf-class="mb-3 #{error.get('ward_id') and 'o_has_error' or ''} col-xl-6"
                 t-att-style="not state_wards and 'display: none'">
                <label class="col-form-label" for="ward_id">
                    Ward / Commune
                </label>
                <select name="ward_id"
                        t-attf-class="form-select #{error.get('ward_id') and 'is-invalid' or ''}"
                        t-att-data-vn_country_id="vn_country_id">
                    <option value="">Ward / Commune...</option>
                    <option
                        t-foreach="state_wards or []"
                        t-as="w"
                        t-att-value="w.id"
                        t-att-selected="w.id == (int(ward_id) if ward_id else partner.ward_id.id)"
                        t-out="w.name"
                    />
                </select>
            </div>
        </xpath>
    </template>
</odoo>
