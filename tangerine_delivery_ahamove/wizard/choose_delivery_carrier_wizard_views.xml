<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_choose_delivery_carrier_form_with_provider_ahamove_express" model="ir.ui.view">
        <field name="name">view.choose.delivery.carrier.form.with.provider.ahamove.express</field>
        <field name="model">choose.delivery.carrier</field>
        <field name="inherit_id" ref="delivery.choose_delivery_carrier_view_form" />
        <field name="arch" type="xml">
            <label for="display_price" position="before">
                <field name="ahamove_service_id" invisible="delivery_type != 'ahamove'" readonly="is_loading_prices"/>
                <field name="ahamove_service_request_ids"
                       widget="many2many_tags"
                       options="{'no_create': True}"
                       invisible="delivery_type != 'ahamove'"
                       readonly="is_loading_prices"
                       domain="[('service_id', '=?', ahamove_service_id)]"
                />
                <label for="is_cod" invisible="delivery_type != 'ahamove'"/>
                <div class="o_row" invisible="delivery_type != 'ahamove'">
                    <field name="is_cod" style="max-width: 15%;" widget="boolean_toggle"/>
                    <field name="cod_amount" invisible="not is_cod"/>
                </div>
                <field name="promo_code" invisible="delivery_type != 'ahamove'" readonly="is_loading_prices"/>
            </label>
        </field>
    </record>
</odoo>
