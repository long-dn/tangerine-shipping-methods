<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Ahamove: IDLE → Confirmed -->
        <record id="ahamove_mapping_idle" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_ahamove.tangerine_delivery_ahamove_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_ahamove.ahamove_idle_status"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_confirmed"/>
            <field name="sequence">10</field>
        </record>

        <!-- Ahamove: ASSIGNING → Confirmed -->
        <record id="ahamove_mapping_assigning" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_ahamove.tangerine_delivery_ahamove_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_ahamove.ahamove_assigning_status"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_confirmed"/>
            <field name="sequence">20</field>
        </record>

        <!-- Ahamove: ACCEPTED → Picking Up -->
        <record id="ahamove_mapping_accepted" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_ahamove.tangerine_delivery_ahamove_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_ahamove.ahamove_accepted_status"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_picking_up"/>
            <field name="sequence">30</field>
        </record>

        <!-- Ahamove: IN PROCESS → In Transit -->
        <record id="ahamove_mapping_in_process" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_ahamove.tangerine_delivery_ahamove_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_ahamove.ahamove_in_process_status"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_in_transit"/>
            <field name="sequence">40</field>
        </record>

        <!-- Ahamove: COMPLETED → Delivered -->
        <record id="ahamove_mapping_completed" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_ahamove.tangerine_delivery_ahamove_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_ahamove.ahamove_completed_status"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_delivered"/>
            <field name="sequence">50</field>
        </record>

        <!-- Ahamove: CANCELLED → Cancelled -->
        <record id="ahamove_mapping_cancelled" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_ahamove.tangerine_delivery_ahamove_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_ahamove.ahamove_cancelled_status"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_cancelled"/>
            <field name="sequence">60</field>
        </record>
    </data>
</odoo>
