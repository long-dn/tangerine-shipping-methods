<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_choose_delivery_carrier_form_with_provider_viettelpost" model="ir.ui.view">
        <field name="name">view.choose.delivery.carrier.form.with.provider.viettelpost</field>
        <field name="model">choose.delivery.carrier</field>
        <field name="inherit_id" ref="delivery.choose_delivery_carrier_view_form" />
        <field name="arch" type="xml">
            <label for="display_price" position="before">
                <field name="viettelpost_service_id"
                       invisible="delivery_type != 'viettelpost'"
                       required="delivery_type == 'viettelpost'"
                       readonly="is_loading_prices"
                />
                <field name="viettelpost_service_extend_id"
                       invisible="delivery_type != 'viettelpost'"
                       readonly="is_loading_prices"
                       domain="[('service_id', '=?', viettelpost_service_id)]"
                />
                <field name="viettelpost_national_type" invisible="delivery_type != 'viettelpost'" readonly="is_loading_prices"/>
                <field name="viettelpost_product_type" invisible="delivery_type != 'viettelpost'" readonly="is_loading_prices"/>
                <label for="is_cod" invisible="delivery_type != 'viettelpost'"/>
                <div class="o_row" invisible="delivery_type != 'viettelpost'">
                    <field name="is_cod" style="max-width: 15%;" widget="boolean_toggle"/>
                    <field name="cod_amount" invisible="not is_cod"/>
                </div>
            </label>
        </field>
    </record>
</odoo>
